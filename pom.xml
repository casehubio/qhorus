<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.casehub</groupId>
    <artifactId>casehub-parent</artifactId>
    <version>0.4-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <artifactId>casehub-qhorus-parent</artifactId>
  <packaging>pom</packaging>

  <name>CaseHub Qhorus - Parent</name>
  <description>Quarkus Native agent communication mesh — peer-to-peer channels, typed messages, shared data, presence</description>
  <url>https://github.com/casehubio/qhorus</url>

  <modules>
    <module>a2a-protocol</module>
    <module>api</module>
    <module>connectors</module>
    <module>runtime-core</module>
    <module>runtime</module>
    <module>connector-backend-core</module>
    <module>connector-backend</module>
    <module>slack-channel-core</module>
    <module>slack-channel</module>
    <module>deployment</module>
    <module>postgres-broadcaster</module>
    <module>kafka-observer</module>
    <module>websocket-observer</module>
    <module>webhook-observer-core</module>
    <module>webhook-observer</module>
    <module>graphql</module>
    <module>a2a-outbound-core</module>
    <module>a2a-outbound</module>
    <module>notification-bridge-core</module>
    <module>notification-bridge</module>
    <module>compliance-report-core</module>
    <module>compliance-report</module>
    <module>push-core</module>
    <module>push</module>
    <module>a2a-push-notification-core</module>
    <module>a2a-push-notification</module>
    <module>agent-card-signing-core</module>
    <module>agent-card-signing</module>
    <module>persistence-memory</module>
    <module>testing</module>
    <module>agent-bridge</module>
    <module>mesh</module>
    <module>cluster</module>
    <module>cache</module>
    <module>examples</module>
  </modules>

  <scm>
    <connection>scm:git:git@github.com:casehubio/qhorus.git</connection>
    <developerConnection>scm:git:git@github.com:casehubio/qhorus.git</developerConnection>
    <url>https://github.com/casehubio/qhorus</url>
    <tag>HEAD</tag>
  </scm>


  <repositories>
    <repository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/*</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/qhorus</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>casehubio GitHub Packages</name>
      <url>https://maven.pkg.github.com/casehubio/qhorus</url>
    </snapshotRepository>
  </distributionManagement>

  <properties>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <quarkus.version>${quarkus.platform.version}</quarkus.version>
    <openhtmltopdf.version>1.1.37</openhtmltopdf.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.openhtmltopdf</groupId>
        <artifactId>openhtmltopdf-pdfbox</artifactId>
        <version>${openhtmltopdf.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.smallrye</groupId>
          <artifactId>jandex-maven-plugin</artifactId>
          <version>3.1.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
</build>

  <profiles>
    <profile>
      <id>native</id>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <properties>
        <skipITs>false</skipITs>
        <quarkus.native.enabled>true</quarkus.native.enabled>
      </properties>
    </profile>
    <profile>
      <id>with-spring</id>
      <modules>
        <module>graphql-spring</module>
        <module>runtime-spring</module>
        <module>kafka-observer-spring</module>
        <module>postgres-broadcaster-spring</module>
        <module>websocket-observer-spring</module>
        <module>qhorus-rest-spring</module>
        <module>spring-integration-test</module>
      </modules>
    </profile>
    <profile>
      <id>with-e2e-cluster</id>
      <modules>
        <module>e2e-cluster</module>
      </modules>
    </profile>
  </profiles>

</project>
